{
    "name": "ronja-discord",
    "version": "2.0.0",
    "description": "A bot for discord guilds that provide a multi gaming community for a circle of friends.",
    "homepage": "https://github.com/YetAnotherGerrit/Ronja.js",
    "bugs": {
        "url": "https://github.com/YetAnotherGerrit/Ronja.js/issues"
    },
    "license": "GPL-3.0-only",
    "author": {
        "name": "YetAnotherGerrit",
        "url": "https://github.com/YetAnotherGerrit"
    },
    "repository": "github:YetAnotherGerrit/Ronja.js",
    "main": "index.js",
    "scripts": {
        "start": "node .",
        "migrate": "npx sequelize-cli db:migrate --env production",
        "migrate-legacy": "node migrate-legacy-database.js",
        "dev:migrate": "npx sequelize-cli db:migrate",
        "dev:migrate:new": "npx sequelize-cli migration:generate --name",
        "dev:lint": "eslint .",
        "dev:lint:fix": "eslint . --fix",
        "dev:format": "prettier . --write",
        "dev:format:check": "prettier . --check"
    },
    "dependencies": {
        "discord.js": "^14.8.0",
        "dotenv": "^16.5.0",
        "ical-generator": "^3.6.1",
        "luxon": "^3.3.0",
        "node-cron": "^3.0.2",
        "sequelize": "^6.28.2",
        "sqlite3": "^5.1.4",
        "ssh2-sftp-client": "^9.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.0",
        "@eslint/markdown": "^8.0.2",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "sequelize-cli": "^6.6.3"
    }
}
