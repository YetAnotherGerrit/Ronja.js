// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Ronja.js Dev Container",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",

	"remoteEnv": {
		"NODE_ENV": "development",
		"PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/node_modules/.bin"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/warrenbuckley/codespace-features/sqlite:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	// Persist Claude Code's state (auth, settings, and its memory/ directory), and the
	// GitHub CLI's auth config (~/.config/gh/hosts.yml), in named volumes, so both survive
	// a devcontainer rebuild instead of living only in the container's own throwaway
	// filesystem layer.
	//
	// A fresh named volume is created owned by root, not by the "node" user this
	// container runs as — that made /home/node/.claude unwritable (so Claude Code
	// login failed writing .credentials.json) until the postCreateCommand below
	// chowns it back to node:node after the mount is in place. Same fix applies to the
	// gh config volume.
	"mounts": [
		"source=ronja-js-claude-home,target=/home/node/.claude,type=volume",
		"source=ronja-js-gh-config,target=/home/node/.config/gh,type=volume"
	],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	//
	// `gh auth setup-git` only edits ~/.gitconfig's credential.helper line, which isn't
	// itself persisted, so it's re-applied on every container start; it's a no-op if
	// already configured, and `|| true` keeps a not-yet-authenticated first run (before
	// `gh auth login` has ever been run against the volume above) from blocking npm
	// install.
	"postCreateCommand": "sudo chown -R node:node /home/node/.claude /home/node/.config/gh && (gh auth setup-git || true) && npm install"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
